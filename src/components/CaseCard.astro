---
interface Props { href: string; title: string; client: string; summary: string; headingLevel?: 'h2' | 'h3' }
const { href, title, client, summary, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<a class="card" href={href}>
  <p class="meta">{client}</p>
  <H>{title}</H>
  <p>{summary}</p>
</a>
