---
import { useT, localePath, type Lang } from '../../i18n/ui';
import { profile } from '../../data/profile';
import HeroGraphic from '../HeroGraphic.astro';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const facts = [
  [t('facts.now'), t('facts.nowValue')],
  [t('facts.focus'), t('facts.focusValue')],
  [t('facts.cloud'), t('facts.cloudValue')],
  [t('facts.lang'), t('facts.langValue')],
];
---
<section class="hero" aria-labelledby="hero-name">
  <div class="wrap grid">
    <div class="copy">
      <h1 id="hero-name"><span>Asad Faiyyaz</span> <span>Khan</span></h1>
      <p class="role">{t('site.role')}</p>
      <p class="intro">{t('hero.intro')}</p>
      <p class="where">{t('hero.location')}</p>
      <div class="btns">
        <a class="btn btn-primary" href={localePath(lang, '/cv/')}><Icon name="doc" />{t('hero.cv')}</a>
        <ExternalLink class="btn" href={profile.linkedin} lang={lang} rel="me" icon={false}><Icon name="linkedin" />LinkedIn</ExternalLink>
        <ExternalLink class="btn" href={profile.github} lang={lang} rel="me" icon={false}><Icon name="github" />GitHub</ExternalLink>
      </div>
    </div>
    <div class="art"><HeroGraphic lang={lang} /></div>
  </div>
  <div class="wrap">
    <dl class="facts">
      {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: calc(100svh - 65px); display: flex; flex-direction: column; justify-content: center;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) 0;
  }
  /* Blueprint grid with a soft glow behind the graphic: the "desk" the document lies on. */
  .hero::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background-image:
      radial-gradient(circle at 72% 45%, color-mix(in srgb, var(--blue) 16%, transparent), transparent 42%),
      linear-gradient(color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 6%, transparent) 1px, transparent 1px);
    background-size: auto, 32px 32px, 32px 32px;
    -webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
    mask-image: linear-gradient(to bottom, #000 70%, transparent);
  }
  .grid { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 1040px) { .grid { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 3rem; } }
  h1 {
    font-size: var(--step-4); line-height: 0.88; letter-spacing: -0.022em; font-weight: 800;
    font-variation-settings: 'opsz' 96, 'wdth' 82;
  }
  h1 span { display: block; }
  .role { margin: 1.6rem 0 0; font-family: var(--font-display); font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem); font-weight: 650; color: var(--blue); letter-spacing: -0.01em; font-variation-settings: 'wdth' 90; }
  .intro { margin: 1.1rem 0 0; font-size: var(--step-1); line-height: 1.5; max-width: 34rem; }
  .where { margin: 1rem 0 2rem; color: var(--ink-soft); }
  .art { width: 100%; max-width: 800px; justify-self: center; padding-bottom: 2.75rem; }

  .facts {
    display: grid; grid-template-columns: 1fr; margin: clamp(2rem, 1rem + 3vw, 3.5rem) 0 0;
    border-top: 1.5px solid var(--ink);
  }
  @media (min-width: 640px) { .facts { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .facts { grid-template-columns: repeat(4, 1fr); } }
  .facts div { padding: 1.1rem 1.25rem 1.4rem 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 1040px) { .facts div { border-bottom: 0; } .facts div + div { padding-left: 1.25rem; border-left: 1px solid var(--rule); } }
  dt { font-size: var(--step--1); font-weight: 600; color: var(--ink-soft); }
  dd { margin: 0.25rem 0 0; font-weight: 500; }
</style>
