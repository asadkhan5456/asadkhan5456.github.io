---
import { useT, type Lang } from '../../i18n/ui';
import { profile } from '../../data/profile';
import Email from '../Email.astro';
import ExternalLink from '../ExternalLink.astro';
import Icon from '../Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section id="contact" class="section contact band-dark" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 id="contact-title" class="visually-hidden">{t('contact.title')}</h2>
    <p class="big" aria-hidden="true">{t('contact.line')}</p>
    <p class="body">{t('contact.body')}</p>
    <ul class="ways">
      <li><Icon name="mail" /><span class="k">{t('contact.email')}</span><Email class="v" /></li>
      <li><Icon name="linkedin" /><span class="k">LinkedIn</span><ExternalLink class="v" href={profile.linkedin} lang={lang} rel="me">linkedin.com/in/ak54</ExternalLink></li>
      <li><Icon name="github" /><span class="k">GitHub</span><ExternalLink class="v" href={profile.github} lang={lang} rel="me">github.com/asadkhan5456</ExternalLink></li>
    </ul>
    <p class="where">{t('hero.location')}</p>
  </div>
</section>
<style>
  .contact { border-top: 0; }
  .big { font-family: var(--font-display); font-weight: 800; font-size: var(--step-4); line-height: 0.95; letter-spacing: -0.03em; margin: 0; font-variation-settings: 'wdth' 88; }
  .big::after { content: ''; display: block; width: 4.5rem; height: 0.35rem; background: var(--marker); margin-top: 1.5rem; border-radius: 2px; }
  .body { margin: 1.75rem 0 2rem; font-size: var(--step-1); max-width: 34rem; color: color-mix(in srgb, var(--paper) 85%, transparent); }
  .ways { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.25rem; max-width: 40rem; }
  .ways li { display: grid; grid-template-columns: 1.4rem 6rem minmax(0, 1fr); align-items: center; gap: 0.75rem; margin: 0; padding: 0.6rem 0; border-bottom: 1px solid color-mix(in srgb, var(--paper) 18%, transparent); }
  .ways li > :global(svg) { width: 1.2rem; height: 1.2rem; color: var(--marker); }
  .k { color: color-mix(in srgb, var(--paper) 65%, transparent); font-size: var(--step--1); font-weight: 600; }
  .ways :global(a) { color: var(--paper); font-weight: 500; font-size: 1.1rem; display: inline-flex; align-items: center; gap: 0.3rem; min-height: 44px; word-break: break-all; }
  .ways :global(a:hover) { color: var(--marker); }
  .ways :global(a svg) { width: 0.9em; height: 0.9em; }
  .where { margin: 2rem 0 0; color: color-mix(in srgb, var(--paper) 65%, transparent); }
</style>
