---
import { getCollection } from 'astro:content';
import { useT, localePath, type Lang } from '../../i18n/ui';
import DiagramThumb from '../DiagramThumb.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const cases = (await getCollection('case-studies', (c) => c.id.startsWith(`${lang}/`))).sort((a, b) => a.data.order - b.data.order);
const slug = (id: string) => id.split('/')[1];
---
<section id="work" class="section" aria-labelledby="work-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="work-title">{t('work.title')}</h2>
      <p>{t('work.note')}</p>
    </div>
    <ul class="rows">
      {cases.map((c) => (
        <li>
          <a class="row" href={localePath(lang, `/work/${slug(c.id)}/`)}>
            <span class="text">
              <span class="client">{c.data.client}</span>
              <span class="title"><span class="marker-link">{c.data.title}</span></span>
              <span class="summary">{c.data.summary}</span>
              <span class="stack">{c.data.stack.join(', ')}</span>
            </span>
            <span class="preview"><DiagramThumb name={c.data.diagram} /></span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .rows li { margin: 0; border-bottom: 1px solid var(--rule); }
  .row { display: grid; gap: 1.5rem 3rem; padding: 2rem 0; color: var(--ink); text-decoration: none; align-items: center; }
  @media (min-width: 900px) { .row { grid-template-columns: minmax(0, 1fr) 380px; padding: 2.5rem 0; } }
  .text { display: grid; gap: 0.55rem; }
  .client { color: var(--blue); font-size: var(--step--1); font-weight: 600; }
  .title { font-family: var(--font-display); font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.2rem); font-weight: 750; line-height: 1.08; letter-spacing: -0.025em; font-variation-settings: 'wdth' 90; letter-spacing: -0.015em; }
  .summary { color: var(--ink-soft); max-width: 40rem; }
  .stack { color: var(--ink-soft); font-size: var(--step--1); }
  .preview {
    display: block; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius);
    padding: 1rem 1.1rem; transition: border-color 0.2s ease, transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (max-width: 899px) { .preview { max-width: 420px; } }
  .row:hover .preview, .row:focus-visible .preview { border-color: var(--blue); transform: translateY(-3px); }
  .row:hover .marker-link, .row:focus-visible .marker-link { background-size: 100% 0.42em; }
  .row:focus-visible { outline-offset: 6px; }
</style>
