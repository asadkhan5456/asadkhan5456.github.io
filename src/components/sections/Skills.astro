---
import { useT, type Lang } from '../../i18n/ui';
import { skills } from '../../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="wrap">
    <div class="section-head"><h2 id="skills-title">{t('skills.title')}</h2></div>
    <div class="groups">
      {skills.map((g) => (
        <div class="group">
          <h3>{g.area[lang]}</h3>
          <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .groups { display: grid; gap: 1px; background: var(--rule); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; }
  @media (min-width: 640px) { .groups { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1060px) { .groups { grid-template-columns: repeat(4, 1fr); } }
  .group { background: var(--surface); padding: 1.6rem 1.5rem 1.8rem; }
  .group:first-child { background: var(--ink); }
  .group:first-child h3, .group:first-child li { color: var(--paper); }
  .group:first-child li::before { background: var(--marker); }
  h3 { font-size: var(--step-1); margin-bottom: 1.1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  li { margin: 0; display: flex; align-items: center; gap: 0.6rem; }
  li::before { content: ''; width: 7px; height: 7px; border-radius: 2px; background: var(--blue); flex: none; }
</style>
