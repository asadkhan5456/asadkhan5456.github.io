---
import { Image } from 'astro:assets';
import photo from '../../assets/asad.jpg';
import { useT, type Lang } from '../../i18n/ui';
import { bio, education, languages, location } from '../../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
---
<section id="about" class="section" aria-labelledby="about-title">
  <div class="wrap grid">
    <figure class="photo">
      <Image src={photo} alt={t('about.photoAlt')} widths={[320, 480, 720]} sizes="(min-width: 900px) 360px, 80vw" format="webp" quality={82} loading="lazy" />
    </figure>
    <div class="text">
      <h2 id="about-title">{t('about.title')}</h2>
      <div class="bio">{bio[lang].map((p) => <p>{p}</p>)}</div>
      <dl class="facts">
        <div><dt>{t('about.based')}</dt><dd>{location[lang]}</dd></div>
        <div><dt>{t('about.languages')}</dt><dd>{languages.map((l) => <span>{l.name[lang]} {l.level}</span>)}</dd></div>
        <div><dt>{t('about.education')}</dt><dd>{education.map((e) => <span>{e.degree[lang]}, {e.school} ({e.dates})</span>)}</dd></div>
      </dl>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 900px) { .grid { grid-template-columns: 360px minmax(0, 1fr); gap: 5rem; } }
  .photo { margin: 0; position: relative; max-width: 360px; }
  .photo :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: var(--radius); }
  /* The extraction box: the same blue outline the hero uses for recognised fields. */
  .photo::after {
    content: ''; position: absolute; inset: -10px -10px 10px 10px; border: 2px solid var(--blue);
    border-radius: calc(var(--radius) + 4px); pointer-events: none;
  }
  .bio { margin-top: 1.5rem; max-width: var(--measure); font-size: 1.1rem; }
  .facts { display: grid; gap: 1.1rem; margin: 2rem 0 0; padding-top: 1.75rem; border-top: 1px solid var(--rule); }
  @media (min-width: 640px) { .facts { grid-template-columns: 1fr 1fr 2fr; gap: 2rem; } }
  dt { font-weight: 600; font-size: var(--step--1); color: var(--ink-soft); }
  dd { margin: 0.3rem 0 0; display: grid; gap: 0.2rem; }
</style>
