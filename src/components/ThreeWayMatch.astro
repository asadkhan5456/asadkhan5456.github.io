---
// DokuPilot in one picture: purchase order, goods receipt and invoice are matched
// line by line, a person approves, and an eval harness checks the agent on synthetic data.
// Plays when it scrolls into view; can be replayed.
import Icon from './Icon.astro';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = lang === 'de'
  ? { docs: ['Bestellung', 'Wareneingang', 'Rechnung'], review: 'Menschliche Freigabe', evalh: 'Eval-Harness · synthetische Daten', replay: 'Erneut abspielen', label: 'Animation: Bestellung, Wareneingang und Rechnung werden Zeile für Zeile abgeglichen, danach folgt eine menschliche Freigabe; ein Eval-Harness prüft den Agenten auf synthetischen Daten.' }
  : { docs: ['Purchase order', 'Goods receipt', 'Invoice'], review: 'Human review', evalh: 'Eval harness · synthetic data', replay: 'Replay', label: 'Animation: purchase order, goods receipt and invoice are matched line by line, then a person approves; an eval harness checks the agent on synthetic data.' };

const cardW = 150, cardH = 168, gap = 30, top = 18;
const xs = [0, 1, 2].map((i) => 10 + i * (cardW + gap));
const rowY = (r: number) => top + 62 + r * 30;
const widths = [[0.72, 0.55, 0.64], [0.6, 0.7, 0.5], [0.68, 0.58, 0.62]];
---
<figure class="twm-fig">
  <svg class="twm" viewBox="0 0 530 330" role="img" aria-label={L.label} xmlns="http://www.w3.org/2000/svg">
    {xs.map((x, c) => (
      <g class="doc" style={`--d:${c * 0.12}s`}>
        <rect x={x} y={top} width={cardW} height={cardH} rx="12" class="card" />
        <text x={x + 14} y={top + 28} class="title">{L.docs[c]}</text>
        <line x1={x + 14} x2={x + cardW - 14} y1={top + 40} y2={top + 40} class="rule" />
        {[0, 1, 2].map((r) => (
          <>
            <rect x={x + 10} y={rowY(r) - 10} width={cardW - 20} height="20" rx="5" class="hl" style={`--d:${0.5 + r * 0.55 + c * 0.12}s`} />
            <rect x={x + 16} y={rowY(r) - 4} width={(cardW - 32) * widths[c][r]} height="8" rx="4" class="bar" />
          </>
        ))}
      </g>
    ))}
    {[0, 1, 2].map((r) => (
      <path d={`M ${xs[0] + cardW - 8} ${rowY(r)} H ${xs[1] + 8} M ${xs[1] + cardW - 8} ${rowY(r)} H ${xs[2] + 8}`} pathLength="1" class="link" style={`--d:${0.75 + r * 0.55}s`} />
    ))}
    {[0, 1, 2].map((r) => (
      <g class="ok" style={`--d:${0.95 + r * 0.55}s; transform-origin:${xs[2] + cardW + 4}px ${rowY(r)}px`}>
        <circle cx={xs[2] + cardW + 4} cy={rowY(r)} r="9" class="ok-c" />
        <path d={`M ${xs[2] + cardW} ${rowY(r)} l 3 3 l 5 -6`} class="ok-p" />
      </g>
    ))}
    <path d={`M ${xs[1] + cardW / 2} ${top + cardH} V ${top + cardH + 30}`} pathLength="1" class="link down" style="--d:2.7s" />
    <g class="review" style="--d:2.95s">
      <rect x={xs[1] - 20} y={top + cardH + 30} width={cardW + 40} height="44" rx="22" class="pill" />
      <circle cx={xs[1] + 4} cy={top + cardH + 52} r="11" class="person" />
      <circle cx={xs[1] + 4} cy={top + cardH + 48.5} r="3.2" class="head" />
      <path d={`M ${xs[1] - 2.5} ${top + cardH + 58} a 6.5 6 0 0 1 13 0`} class="head" />
      <text x={xs[1] + 22} y={top + cardH + 57} class="pill-text">{L.review}</text>
    </g>
    <g class="evalbar" style="--d:3.35s">
      <rect x="10" y={top + cardH + 96} width="510" height="30" rx="8" class="eval-bg" />
      <rect x="10" y={top + cardH + 96} width="510" height="30" rx="8" class="eval-fill" />
      <text x="24" y={top + cardH + 116} class="eval-text">{L.evalh}</text>
    </g>
  </svg>
  <button type="button" class="replay"><Icon name="replay" /><span>{L.replay}</span></button>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.twm-fig').forEach((fig) => {
    const svg = fig.querySelector('svg')!;
    const play = () => { svg.classList.remove('play'); void svg.getBoundingClientRect(); svg.classList.add('play'); };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
    svg.classList.add('armed');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { play(); io.disconnect(); } }), { threshold: 0.45 });
    io.observe(svg);
    fig.querySelector('.replay')?.addEventListener('click', play);
  });
</script>

<style>
  .twm-fig { margin: 0; position: relative; }
  .twm { width: 100%; height: auto; display: block; overflow: visible; }
  .card { fill: var(--paper); stroke: color-mix(in srgb, var(--paper) 40%, var(--ink)); stroke-width: 1; }
  .title { fill: var(--ink); font: 650 13px var(--font-body); }
  .rule { stroke: var(--rule); stroke-width: 1; }
  .bar { fill: color-mix(in srgb, var(--ink) 30%, transparent); }
  .hl { fill: var(--marker); opacity: 0.85; }
  .link { fill: none; stroke: var(--marker); stroke-width: 2; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .ok-c { fill: var(--marker); }
  .ok-p, .head { fill: none; stroke: var(--marker-ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .head { stroke-width: 1.7; fill: none; }
  .pill { fill: var(--paper); }
  .person { fill: var(--marker); }
  .pill-text { fill: var(--ink); font: 600 13px var(--font-body); }
  .eval-bg { fill: color-mix(in srgb, var(--paper) 12%, transparent); }
  .eval-fill { fill: color-mix(in srgb, var(--blue) 55%, var(--paper)); transform-box: fill-box; transform-origin: left center; }
  .eval-text { fill: var(--ink); font: 600 12.5px var(--font-body); }

  /* Before it scrolls into view: hidden, then the sequence plays once. */
  .armed:not(.play) :is(.hl, .link, .ok, .review, .evalbar) { opacity: 0; }
  .play .doc { animation: twm-in 0.45s ease-out var(--d) both; }
  .play .hl { transform-box: fill-box; transform-origin: left center; animation: twm-grow 0.35s ease-out var(--d) both; }
  .play .link { animation: twm-draw 0.5s ease-in-out var(--d) both; }
  .play .ok { animation: twm-pop 0.4s cubic-bezier(0.3, 1.7, 0.5, 1) var(--d) both; }
  .play .review { animation: twm-in 0.45s ease-out var(--d) both; }
  .play .evalbar { animation: twm-fade 0.3s ease-out var(--d) both; }
  .play .eval-fill { animation: twm-grow 1.4s cubic-bezier(0.3, 0.7, 0.2, 1) calc(var(--d, 3.35s) + 0.2s) both; }
  @keyframes twm-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes twm-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes twm-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes twm-pop { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes twm-fade { from { opacity: 0; } to { opacity: 1; } }

  .replay {
    margin-top: 0.75rem; display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; padding: 0 0.85rem;
    font: 500 0.85rem var(--font-body); color: color-mix(in srgb, var(--paper) 80%, transparent); background: transparent;
    border: 1px solid color-mix(in srgb, var(--paper) 30%, transparent); border-radius: 999px; cursor: pointer;
  }
  .replay:hover { color: var(--paper); border-color: var(--paper); }
  @media (prefers-reduced-motion: reduce) { .replay { display: none; } }
</style>
