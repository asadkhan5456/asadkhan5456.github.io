---
// A text-free miniature of a case-study architecture, used as a preview image.
import { getDiagram, type DiagramKey } from '../data/diagrams';
interface Props { name: DiagramKey }
const { name } = Astro.props;
const d = getDiagram(name, 'en');
const path = (pts: [number, number][]) => 'M ' + pts.map((p) => p.join(' ')).join(' L ');
---
<svg class="thumb" viewBox={`0 0 ${d.width} ${d.height}`} aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
  {d.groups.map((g) => <rect x={g.x} y={g.y} width={g.w} height={g.h} rx="18" class="t-group" />)}
  {d.edges.map((e) => <path d={path(e.points)} class="t-edge" />)}
  {d.nodes.map((n) => (
    <g>
      <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="10" class={`t-node t-${n.kind ?? 'default'}`} />
      <rect x={n.x + n.w * 0.2} y={n.y + n.h / 2 - 4} width={n.w * 0.6} height="8" rx="4" class="t-text" />
    </g>
  ))}
</svg>
<style>
  .thumb { width: 100%; height: auto; display: block; }
  .t-group { fill: none; stroke: var(--ink-soft); stroke-width: 2; stroke-dasharray: 6 8; opacity: 0.6; }
  .t-edge { fill: none; stroke: var(--blue); stroke-width: 3; }
  .t-node { fill: var(--surface); stroke: var(--rule); stroke-width: 2.5; }
  .t-accent { fill: var(--blue-soft); stroke: var(--blue); }
  .t-io { fill: var(--paper); stroke: var(--ink-soft); }
  .t-text { fill: color-mix(in srgb, var(--ink) 22%, transparent); }
</style>
