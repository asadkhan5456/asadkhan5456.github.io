---
// Email address assembled in the browser so it never appears as plain text in the HTML.
import { profile } from '../data/profile';
interface Props { class?: string }
const { class: cls } = Astro.props;
const u = [...profile.emailUser].reverse().join('');
const d = [...profile.emailDomain].reverse().join('');
const fallback = `${profile.emailUser} [at] ${profile.emailDomain.replace('.', ' [dot] ')}`;
---
<span class="js-email" data-u={u} data-d={d} data-class={cls}>{fallback}</span>
<script>
  document.querySelectorAll<HTMLElement>('.js-email[data-u]').forEach((el) => {
    const u = [...(el.dataset.u ?? '')].reverse().join('');
    const d = [...(el.dataset.d ?? '')].reverse().join('');
    const a = document.createElement('a');
    a.href = 'mailto:' + u + '@' + d;
    a.textContent = u + '@' + d;
    if (el.dataset.class) a.className = el.dataset.class;
    el.replaceChildren(a);
    el.removeAttribute('data-u');
    el.removeAttribute('data-d');
  });
</script>
