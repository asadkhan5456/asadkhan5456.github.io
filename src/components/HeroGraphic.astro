---
// The page's one orchestrated animation: a document is scanned, three fields are
// highlighted, agents pick them up and a structured record is assembled.
import { useT, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);

const nodes = lang === 'de' ? ['Extraktion', 'Validierung', 'Orchestrator'] : ['Extraction', 'Validation', 'Orchestrator'];
const json =
  lang === 'de'
    ? ['{', '  "typ": "Rechnung",', '  "von": "Muster GmbH",', '  "felder": 3,', '  "status": "geprüft"', '}']
    : ['{', '  "type": "invoice",', '  "from": "Example Ltd",', '  "fields": 3,', '  "status": "validated"', '}'];

// Document text lines (relative widths) and which rows become extracted fields.
const rows = [0.62, 0.9, 0.78, 0.84, 0.55, 0.92, 0.7, 0.86, 0.64, 0.8, 0.5];
const fields = [1, 5, 8];
const docX = 24, docY = 40, docW = 200, docH = 300, pad = 20;
const rowY = (i: number) => docY + 66 + i * 20;
const nodeX = 300;
const nodeY = [118, 205, 292];
const card = { x: 360, y: 96, w: 206, h: 214 };
---

<figure class="hg-figure">
  <svg class="hg play" viewBox="0 0 570 390" role="img" aria-label={t('hero.graphicLabel')} xmlns="http://www.w3.org/2000/svg">
    <!-- document -->
    <g class="doc">
      <rect x={docX} y={docY} width={docW} height={docH} rx="12" class="paper" />
      <path d={`M ${docX + docW - 34} ${docY} v 22 a 12 12 0 0 0 12 12 h 22`} class="fold" />
      <rect x={docX + pad} y={docY + 22} width="34" height="18" rx="4" class="tag" />
      <text x={docX + pad + 17} y={docY + 35} text-anchor="middle" class="tag-text">PDF</text>
      {fields.map((r, k) => (
        <rect x={docX + pad - 6} y={rowY(r) - 9} width={(docW - 2 * pad) * rows[r] + 12} height="18" rx="4"
          class="hl" style={`--d:${0.55 + k * 0.42}s`} />
      ))}
      {rows.map((w, i) => (
        <rect x={docX + pad} y={rowY(i) - 4} width={(docW - 2 * pad) * w} height="8" rx="4" class={fields.includes(i) ? 'line line-f' : 'line'} />
      ))}
      {fields.map((r, k) => (
        <rect x={docX + pad - 8} y={rowY(r) - 11} width={(docW - 2 * pad) * rows[r] + 16} height="22" rx="5"
          class="bbox" style={`--d:${0.7 + k * 0.42}s`} />
      ))}
      <g class="scan"><rect x={docX + 6} y={docY + 50} width={docW - 12} height="3" rx="1.5" class="scanline" /></g>
    </g>

    <!-- connectors from fields to agents -->
    {fields.map((r, k) => {
      const x1 = docX + pad + (docW - 2 * pad) * rows[r] + 10;
      const y1 = rowY(r);
      const x2 = nodeX - 24;
      const y2 = nodeY[k];
      return <path d={`M ${x1} ${y1} C ${x1 + 40} ${y1}, ${x2 - 40} ${y2}, ${x2} ${y2}`} pathLength="1" class="edge" style={`--d:${1.75 + k * 0.18}s`} />;
    })}

    <!-- agents -->
    <line x1={nodeX} y1={nodeY[0]} x2={nodeX} y2={nodeY[2]} class="spine" />
    <text x={nodeX} y={nodeY[0] - 36} text-anchor="middle" class="mcp">MCP</text>
    {nodeY.map((y, k) => (
      <g class="node" style={`--d:${2.0 + k * 0.18}s; transform-origin:${nodeX}px ${y}px`}>
        <circle cx={nodeX} cy={y} r="22" class="node-c" />
        <circle cx={nodeX} cy={y} r="6" class="node-dot" />
        <text x={nodeX} y={y + 40} text-anchor="middle" class="node-label">{nodes[k]}</text>
      </g>
    ))}

    <!-- agents to record -->
    {nodeY.map((y, k) => (
      <path d={`M ${nodeX + 24} ${y} C ${nodeX + 44} ${y}, ${card.x - 22} ${card.y + card.h / 2}, ${card.x} ${card.y + card.h / 2}`}
        pathLength="1" class="edge edge-out" style={`--d:${2.55 + k * 0.08}s`} />
    ))}

    <!-- structured record -->
    <g class="card" style="--d:2.7s">
      <rect x={card.x} y={card.y} width={card.w} height={card.h} rx="12" class="card-bg" />
    </g>
    {json.map((line, i) => (
      <text x={card.x + 16} y={card.y + 40 + i * 28} class="code" style={`--d:${2.95 + i * 0.16}s`} xml:space="preserve">{line}</text>
    ))}
    <g class="check" style={`--d:3.95s; transform-origin:${card.x + card.w - 24}px ${card.y + 40 + 5 * 28 - 4}px`}>
      <circle cx={card.x + card.w - 24} cy={card.y + 40 + 5 * 28 - 4} r="11" class="check-c" />
      <path d={`M ${card.x + card.w - 29} ${card.y + 40 + 5 * 28 - 4} l 4 4 l 7 -8`} class="check-p" />
    </g>
  </svg>
  <button type="button" class="replay" aria-label={lang === 'de' ? 'Animation erneut abspielen' : 'Replay animation'}>
    <Icon name="replay" /><span aria-hidden="true">{lang === 'de' ? 'Erneut abspielen' : 'Replay'}</span>
  </button>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.hg-figure').forEach((fig) => {
    const svg = fig.querySelector('svg');
    fig.querySelector('.replay')?.addEventListener('click', () => {
      svg?.classList.remove('play');
      void (svg as unknown as HTMLElement)?.getBoundingClientRect();
      svg?.classList.add('play');
    });
  });
</script>

<style>
  .hg-figure { margin: 0; position: relative; }
  .hg { width: 100%; height: auto; display: block; overflow: visible; }

  .paper { fill: var(--surface); stroke: var(--rule); stroke-width: 1.5; filter: drop-shadow(0 22px 36px rgba(14, 23, 38, 0.16)); }
  .fold { fill: none; stroke: var(--rule); stroke-width: 1.5; }
  .tag { fill: var(--ink); }
  .tag-text { fill: var(--paper); font: 700 10px var(--font-body); letter-spacing: 0.04em; }
  .line { fill: color-mix(in srgb, var(--ink) 14%, transparent); }
  .line-f { fill: color-mix(in srgb, var(--ink) 34%, transparent); }
  .hl { fill: var(--marker); opacity: 0.9; }
  .bbox { fill: none; stroke: var(--blue); stroke-width: 1.6; }
  .scanline { fill: var(--blue); filter: drop-shadow(0 0 6px var(--blue)); }
  .edge { fill: none; stroke: var(--blue); stroke-width: 1.6; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .edge-out { stroke: color-mix(in srgb, var(--blue) 60%, var(--ink-soft)); }
  .spine { stroke: var(--rule); stroke-width: 2; stroke-dasharray: 3 5; }
  .mcp { fill: var(--ink-soft); font: 600 13px var(--font-body); letter-spacing: 0.02em; }
  .node-c { fill: var(--blue-soft); stroke: var(--blue); stroke-width: 1.6; }
  .node-dot { fill: var(--blue); }
  .node-label { fill: var(--ink); font: 600 13px var(--font-body); }
  .card-bg { fill: var(--ink); }
  .code { fill: var(--paper); font: 500 11.5px var(--font-mono); white-space: pre; }
  .check-c { fill: var(--marker); }
  .check-p { fill: none; stroke: var(--marker-ink); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  /* The sequence. Final state is the default; animations start from hidden. */
  .play .scan { animation: scan 1.7s cubic-bezier(0.45, 0, 0.55, 1) 0.15s both; }
  .play .hl { transform-box: fill-box; transform-origin: left center; animation: grow 0.35s ease-out var(--d) both; }
  .play .bbox { animation: fade 0.3s ease-out var(--d) both; }
  .play .edge { animation: draw 0.55s ease-in-out var(--d) both; }
  .play .node { animation: pop 0.4s cubic-bezier(0.3, 1.6, 0.5, 1) var(--d) both; }
  .play .card { animation: fade 0.35s ease-out var(--d) both; }
  .play .code { animation: type 0.25s steps(4) var(--d) both; }
  .play .check { animation: pop 0.45s cubic-bezier(0.3, 1.8, 0.5, 1) var(--d) both; }

  @keyframes scan {
    0% { transform: translateY(0); opacity: 0; }
    8% { opacity: 1; }
    88% { opacity: 1; }
    100% { transform: translateY(250px); opacity: 0; }
  }
  .scan { opacity: 0; }
  @keyframes grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes pop { from { transform: scale(0); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes type { from { opacity: 0; transform: translateX(-6px); } to { opacity: 1; transform: none; } }

  .replay {
    position: absolute; right: 0; bottom: -0.5rem;
    display: inline-flex; align-items: center; gap: 0.35rem; min-height: 44px; padding: 0 0.85rem;
    font: 500 0.85rem var(--font-body); color: var(--ink-soft); background: transparent;
    border: 1px solid var(--rule); border-radius: 999px; cursor: pointer;
  }
  .replay:hover { color: var(--ink); border-color: var(--ink-soft); }
  .replay :global(svg) { width: 0.95rem; height: 0.95rem; }
  @media (prefers-reduced-motion: reduce) { .replay { display: none; } }
</style>
