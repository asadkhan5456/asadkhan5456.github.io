---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useT, localePath, neutralPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang; title?: string; description?: string; ogType?: 'website' | 'article' }
const { lang, title, description, ogType = 'website' } = Astro.props;
const t = useT(lang);
const desc = description ?? t('site.description');
const fullTitle = title ? `${title} · Asad Faiyyaz Khan` : `Asad Faiyyaz Khan · ${t('site.titleSuffix')}`;
const neutral = neutralPath(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = (l: Lang) => new URL(localePath(l, neutral), Astro.site);
const ogImage = new URL(lang === 'de' ? '/og-de.png' : '/og-en.png', Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={alt('de')} />
    <link rel="alternate" hreflang="en" href={alt('en')} />
    <link rel="alternate" hreflang="x-default" href={alt('de')} />
    <link rel="preload" href="/fonts/bricolage-display.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="author" content="Asad Faiyyaz Khan" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Asad Faiyyaz Khan" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Asad Faiyyaz Khan · ${t('site.role')}`} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_GB' : 'de_DE'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () { try { var s = localStorage.getItem('theme'); if (s === 'light' || s === 'dark') document.documentElement.setAttribute('data-theme', s); } catch (e) {} })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
