---
import Base from '../layouts/Base.astro';
import Email from '../components/Email.astro';
import { t } from '../i18n/ui';
import { profile } from '../data/profile';
---

<Base title={t('contact.title')} description="Contact Asad Faiyyaz Khan by email or LinkedIn.">
  <div class="prose">
    <h1>{t('contact.title')}</h1>
    <p class="lead">{t('contact.intro')}</p>
    <dl class="contact">
      <div><dt>{t('contact.email')}</dt><dd><Email /></dd></div>
      <div><dt>LinkedIn</dt><dd><a href={profile.linkedin} rel="me">linkedin.com/in/ak54</a></dd></div>
      <div><dt>GitHub</dt><dd><a href={profile.github} rel="me">github.com/asadkhan5456</a></dd></div>
    </dl>
    <p class="muted">{t('home.location')}</p>
  </div>
</Base>

<style>
  .contact { display: grid; gap: 1rem; margin: 1.5rem 0 2rem; }
  dt { font-weight: 600; }
  dd { margin: 0.2rem 0 0; }
</style>
