---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseCard from '../../components/CaseCard.astro';
import { t } from '../../i18n/ui';

const cases = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={t('work.title')} description="Case studies: multi-agent document processing, MCP-based document intelligence, a Microsoft Fabric data platform and a multilingual voice assistant.">
  <h1>{t('work.title')}</h1>
  <p class="lead">{t('work.intro')}</p>
  <p class="note">{t('work.note')}</p>
  <div class="grid grid-2">
    {cases.map((c) => (
      <CaseCard href={`/work/${c.id}/`} title={c.data.title} client={c.data.client} summary={c.data.summary} headingLevel="h2" />
    ))}
  </div>
  <p class="muted small">{t('work.footer')}</p>
</Base>

<style>
  .grid :global(h2) { font-size: 1.1rem; margin-top: 0; }
  .small { font-size: 0.9rem; margin-top: 2rem; }
</style>
