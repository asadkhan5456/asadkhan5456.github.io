---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/ui';

const posts = (await getCollection('posts', (p) => !p.data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
---

<Base title={t('writing.title')} description="Writing on agentic systems, the Model Context Protocol and document AI.">
  <h1>{t('writing.title')}</h1>
  <p class="lead">{t('writing.intro')}</p>
  {posts.length === 0 ? (
    <p class="muted">{t('writing.empty')}</p>
  ) : (
    <ul class="posts">
      {posts.map((p) => (
        <li><a href={`/writing/${p.id}/`}>{p.data.title}</a> <span class="muted">{p.data.description}</span></li>
      ))}
    </ul>
  )}
</Base>
