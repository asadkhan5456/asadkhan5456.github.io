---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
import { profile } from '../data/profile';
---

<Base title={t('cv.title')} description="Download the CV of Asad Faiyyaz Khan, Senior AI Engineer (PDF).">
  <div class="prose">
    <h1>{t('cv.title')}</h1>
    <p class="lead">{t('cv.intro')}</p>
    <div class="btn-row">
      <a class="btn btn-primary" href={profile.cvPath} download>{t('cv.download')}</a>
    </div>
  </div>
</Base>
