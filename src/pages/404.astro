---
import Base from '../layouts/Base.astro';
import { useT } from '../i18n/ui';
const de = useT('de');
const en = useT('en');
---
<Base lang="de" title={de('notfound.title')}>
  <div class="wrap nf">
    <h1>404</h1>
    <p class="lead">{de('notfound.body')}</p>
    <p><a href="/">{de('notfound.home')}</a> · <a href="/en/" lang="en">{en('notfound.home')}</a></p>
  </div>
</Base>
<style>
  .nf { padding-block: 6rem; }
  h1 { font-size: var(--step-4); font-weight: 800; letter-spacing: -0.05em; }
  .lead { font-size: var(--step-1); color: var(--ink-soft); margin: 1rem 0; }
</style>
