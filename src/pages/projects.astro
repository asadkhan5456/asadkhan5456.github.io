---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={t('projects.title')} description="Personal projects, including DokuPilot, an MCP-native document agent for German business documents.">
  <h1>{t('projects.title')}</h1>
  <p class="lead">{t('projects.intro')}</p>
  <div class="grid grid-2">
    {projects.map((p) => (
      <article class="card">
        <p class="meta"><span class="badge">{p.data.status}</span></p>
        <h2>{p.data.title}</h2>
        <p>{p.data.summary}</p>
        {p.data.stack.length > 0 && <ul class="tags">{p.data.stack.map((s) => <li>{s}</li>)}</ul>}
        {p.data.repo && p.data.repoPublic && (
          <p class="repo"><a href={p.data.repo}>{t('projects.repo')}<span class="visually-hidden">: {p.data.title}</span></a></p>
        )}
      </article>
    ))}
  </div>
  <p class="muted more">{t('projects.more')}</p>
</Base>

<style>
  .card h2 { font-size: 1.15rem; margin: 0 0 0.4rem; }
  .repo { margin-top: 0.9rem !important; }
  .more { margin-top: 1.5rem; }
</style>
